{
  "name": "component-doc-preview",
  "displayName": "Component Doc Preview",
  "description": "Preview custom JSDoc Markdown blocks from the active file in the VS Code sidebar.",
  "version": "0.0.2",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:componentDocPreview.view"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "componentDocPreview",
          "title": "组件文档",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "componentDocPreview": [
        {
          "id": "componentDocPreview.view",
          "name": "当前文件文档",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "componentDocPreview.refresh",
        "title": "Component Doc Preview: Refresh"
      }
    ],
    "configuration": {
      "title": "Component Doc Preview",
      "properties": {
        "componentDocPreview.tags": {
          "type": "array",
          "default": [
            "componentDoc",
            "logicDoc"
          ],
          "description": "JSDoc custom tags to render as Markdown."
        },
        "componentDocPreview.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Delay before refreshing the preview after editing the active file."
        },
        "componentDocPreview.fileExtensions": {
          "type": "array",
          "default": [
            ".vue",
            ".js",
            ".ts"
          ],
          "description": "File extensions that can be scanned for component documentation."
        },
        "componentDocPreview.projectDocFiles": {
          "type": "array",
          "default": [
            "src/main.ts",
            "src/main.js",
            "src/App.vue",
            "src/extension.ts"
          ],
          "description": "Workspace-relative existing source files to scan for the project-level @projectDoc block. The first existing file is used."
        },
        "componentDocPreview.projectDocTag": {
          "type": "string",
          "default": "projectDoc",
          "description": "JSDoc tag used for project-level Markdown documentation."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "install:local": "npm run compile && vsce package --out component-doc-preview.vsix && code --install-extension component-doc-preview.vsix --force",
    "package:vsix": "vsce package",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "2.15.0",
    "typescript": "^5.4.5"
  }
}
